# ============================================
# Bo-Distiller 环境变量配置
# ============================================
#
# 说明：
# 1. 复制此文件为 .env 并填入实际值
# 2. 只包含影响项目启动的核心配置
# 3. 其他配置（LLM、飞书等）在 Web UI 中管理，存储在数据库
# ============================================

# ============================================
# 数据库配置（必需）
# ============================================

# 数据库类型：sqlite 或 mysql
DATABASE_TYPE=sqlite

# SQLite 配置（DATABASE_TYPE=sqlite 时使用）
SQLITE_DB_PATH=./data/distiller.db

# MySQL 配置（DATABASE_TYPE=mysql 时使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=distill

# ============================================
# Web 服务配置（可选）
# ============================================

# 后端服务端口
BACKEND_PORT=8000

# 前端服务端口
FRONTEND_PORT=5173
